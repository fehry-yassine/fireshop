# Backend
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/localmarket?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
BACKEND_PORT=4000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1"
# Backward-compatible fallback if CORS_ALLOWED_ORIGINS is not set.
FRONTEND_ORIGIN="http://localhost:3000"
AUTH_COOKIE_SECURE=false
JSON_BODY_LIMIT="256kb"
FORM_BODY_LIMIT="64kb"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
INTERNAL_API_URL="http://localhost:4000/api"
NEXT_API_PROXY_TARGET="http://localhost:4000"

# Email (SMTP) — optional; leave blank to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM="FireShop <noreply@fireshop.com>"

# Local database
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=localmarket
